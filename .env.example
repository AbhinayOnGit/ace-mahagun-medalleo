# ── Public (inlined into the browser bundle at build time) ─────────────────
# Canonical site URL (no trailing slash). Used for canonical, OG, sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact channels. Leave EMPTY to hide the related buttons — never put an invented number here.
# WhatsApp: digits only with country code, e.g. 9198XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Click-to-call display number, e.g. "+91 98XXX XXXXX" (quote it — it contains spaces)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Advertiser identity (shown in footer / legal pages). Required by UP RERA if the advertiser is an agent.
NEXT_PUBLIC_ADVERTISER_NAME=
NEXT_PUBLIC_AGENT_RERA_NUMBER=

# Brochure link revealed only AFTER a brochure enquiry is submitted (optional).
NEXT_PUBLIC_BROCHURE_URL=

# ── Server only (never exposed to the browser) ─────────────────────────────
# Supabase project URL and PUBLISHABLE key (sb_publishable_... or legacy anon key).
# The service-role key is NOT needed and must NOT be added.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# true  = leads are stored with is_test=true and lead_status='Test' (use on previews)
# false = live leads (production only, after approval)
LEAD_TEST_MODE=true

# Search indexing is only enabled when VERCEL_ENV=production AND this is "true".
ALLOW_INDEXING=false
